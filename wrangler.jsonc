{
  "name": "fretboard-hero",
  "compatibility_date": "2024-09-25",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/billing/*"
    ]
  },
  "main": "worker.js",
  "ratelimits": [
    {
      "name": "PLAY_BILLING_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
